<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8F2"
    android:padding="20dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recipesBackButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:textAllCaps="false"
        android:textColor="#47765B" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="YOUR NEXT MEAL"
        android:textColor="#47765B"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Recipes"
        android:textColor="#20382B"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/recipeStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Recipes you can make with your ingredients."
        android:textColor="#566459"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/refreshRecipesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Find Available Recipes"
        android:textAllCaps="false"
        app:backgroundTint="#47765B"
        app:cornerRadius="12dp" />

    <ListView
        android:id="@+id/recipesListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:divider="#D5E0D3"
        android:dividerHeight="1dp" />

</LinearLayout>